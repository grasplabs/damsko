{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@grasp-os/ui/lib/*": ["./src/lib/*"],
      "@grasp-os/ui/hooks/*": ["./src/hooks/*"],
      "@grasp-os/ui/blocks/*": ["./src/blocks/*"],
      "@grasp-os/ui/components/data-grid": [
        "./src/components/data-grid/index.ts"
      ],
      "@grasp-os/ui/components/data-table": [
        "./src/components/data-table/index.ts"
      ],
      "@grasp-os/ui/components/markdown": [
        "./src/components/markdown/index.ts"
      ],
      "@grasp-os/ui/components/*": ["./src/components/*.tsx"]
    }
  },
  "include": [
    "src",
    "examples",
    "tokens",
    "scripts",
    "tests",
    "site/**/*.ts",
    "site/**/*.tsx",
    "astro.config.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
